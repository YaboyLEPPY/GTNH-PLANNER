{"id":"AAAAAAAAAAAAAAAAAAAB8Q==","name":"Lit Way to Get Charred","description":"The \"Charcoal Pile Igniter\" is an alternative option for mass-producing charcoal. It does not consume any power or steam, but generates a lot of pollution. Follow the steps below to get it working.\n\n1. Build a brick floor no bigger than 11x11 in size.\n2. Place 1-5 layers of logs atop the brick floor. No air gaps allowed.\n3. Place the Charcoal Pile Igniter above the top-center log.\n4. Surround the remaining logs in dirt or grass.\n5. The Charcoal Pile Igniter immediately starts processing\n6. After some time, the logs are converted to brittle charcoal blocks.\n7. Break the blocks with an axe for the charcoal (Luck/Fortune has NO effect on the drop rates).\n\nIf this is your first multiblock, read the extended tooltip (hold shift) for construction requirements, or visit [url]https://wiki.gtnewhorizons.com/wiki/Charcoal_Pile_Igniter[/url] for more information and step-by-step images.","icon":{"Count":1,"Damage":1155,"OreDict":"","id":"gregtech:gt.blockmachines","resolved":{"id":"i:gregtech:gt.blockmachines:1155","name":"Charcoal Pile Igniter","mod":"gregtech","registry":"gt.blockmachines","icon":23189,"nbt":null,"kind":"item","unit":"items","damage":1155,"shard":"dbeaa5ee42887df2","recipes":1},"label":"Charcoal Pile Igniter"},"prerequisites":["AAAAAAAAAAAAAAAAAAADtA==","AAAAAAAAAAAAAAAAAAAB3g=="],"tasks":{"0":{"autoConsume":0,"consume":0,"groupDetect":0,"ignoreNBT":1,"index":0,"partialMatch":1,"requireOnlyOneItem":0,"requiredItems":{"0":{"Count":4,"Damage":17300,"OreDict":"","id":"gregtech:gt.metaitem.01","resolved":{"id":"i:gregtech:gt.metaitem.01:17300","name":"Bronze Plate","mod":"gregtech","registry":"gt.metaitem.01","icon":37001,"nbt":null,"kind":"item","unit":"items","damage":17300,"shard":"434140d7d3452fae","recipes":22},"label":"Bronze Plate"}},"taskID":"bq_standard:optional_retrieval"},"1":{"autoConsume":0,"consume":0,"groupDetect":0,"ignoreNBT":1,"index":1,"partialMatch":1,